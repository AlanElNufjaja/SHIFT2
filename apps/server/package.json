{
  "name": "@fieldshift/server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Field Shift backend: NASA/USDA/USGS/ESA data connectors, spatial/temporal harmonization and API.",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc --noEmit",
    "start": "tsx src/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "smoke": "tsx src/smoke.ts"
  },
  "dependencies": {
    "@fieldshift/core": "*",
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "tsx": "^4.19.3"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/node": "^22.13.0",
    "@types/supertest": "^6.0.2",
    "supertest": "^7.0.0",
    "vitest": "^3.2.4"
  }
}
